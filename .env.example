# Copy to .env. The admin signs in with this email and a unique password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret admin URL path (replaces /admin). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PATH=
PORT=3001
# Persistent writable directory; defaults to ./storage
# DATA_DIR=/var/lib/portfolio

# Use supabase for cloud storage. Leave file until the secret key is set.
DATA_BACKEND=file
SUPABASE_URL=https://gtgjapgcahumlhkkbwhj.supabase.co
# Server-only secret key (Project settings → API Keys → Secret keys). Never use a VITE_ variable.
SUPABASE_SECRET_KEY=
